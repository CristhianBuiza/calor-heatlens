{
  "name": "@calor/dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && rm -rf .next/standalone/.next/static && cp -r .next/static .next/standalone/.next/static",
    "start": "node --max-old-space-size=192 .next/standalone/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
