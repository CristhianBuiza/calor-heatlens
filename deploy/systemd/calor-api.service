[Unit]
Description=Calor heatmap API
After=network.target

[Service]
Type=simple
User=calor
Group=calor
WorkingDirectory=/opt/calor
ExecStart=/opt/calor/bin/calor-api
# CALOR_ADMIN_KEY=... (and any overrides) live here, readable by root only.
EnvironmentFile=/etc/calor/calor.env
Environment=CALOR_ADDR=127.0.0.1:8080
Environment=CALOR_DB_PATH=/var/lib/calor/calor.db
Environment=CALOR_TRACKER_DIR=/opt/calor/tracker/dist
Environment=GOMEMLIMIT=192MiB
Environment=CALOR_RETENTION_DAYS=90
StateDirectory=calor
# Go heap is capped by GOMEMLIMIT and SQLite by CALOR_SQLITE_HEAP_MB (64);
# measured peak under the bundled load test is ~150 MiB RSS.
MemoryHigh=256M
MemoryMax=320M
TasksMax=64
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/calor

[Install]
WantedBy=multi-user.target
